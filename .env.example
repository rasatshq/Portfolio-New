# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real values.

# ── Required ──────────────────────────────────────────────────────────────────
# The canonical public URL of your deployed site (no trailing slash).
# Used for metadataBase (OG images, canonical URLs).
# Example: https://portfolio-rashad.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── Optional ──────────────────────────────────────────────────────────────────
# GitHub Personal Access Token — raises rate limit from 60 to 5,000 req/hr.
# Generate at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# Admin CMS Password — used to log into /admin dashboard to manage projects.
# Default if unset: admin123
ADMIN_PASSWORD=admin123

# ── Vercel / Serverless CMS Persistence (choose one for production edits) ───
# Option 1: Vercel Blob (recommended — supports both CMS data & image uploads)
# BLOB_READ_WRITE_TOKEN=
#
# Option 2: Upstash Redis / Vercel KV
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# Option 3: GitHub Repository API (uses GITHUB_TOKEN with Contents: Read & write)
# GITHUB_CMS_REPO=rasatshq/Portfolio-New
# GITHUB_CMS_BRANCH=main
