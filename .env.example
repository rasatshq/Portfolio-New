# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real values.

# ── Required ──────────────────────────────────────────────────────────────────
# The canonical public URL of your deployed site (no trailing slash).
# Used for metadataBase (OG images, canonical URLs).
# Example: https://portfolio-rashad.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── Optional ──────────────────────────────────────────────────────────────────
# GitHub Personal Access Token — raises rate limit from 60 to 5,000 req/hr.
# Generate at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=
